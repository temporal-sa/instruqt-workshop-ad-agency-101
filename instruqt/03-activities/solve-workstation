#!/bin/bash
set -euxo pipefail
cd /root/workshop

if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
  nohup uv run services/adnet.py >/tmp/adnet.log 2>&1 &
  sleep 2
fi
if ! temporal operator cluster health >/dev/null 2>&1; then
  nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
    --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
  for i in $(seq 1 30); do
    temporal operator cluster health >/dev/null 2>&1 && break
    sleep 1
  done
fi

pkill -f "03-activities.*worker.py" || true
cp -f exercises/03-activities/solution/*.py exercises/03-activities/practice/
nohup uv run exercises/03-activities/practice/worker.py >/tmp/worker-03.log 2>&1 &
sleep 3

temporal workflow start --type SocialPostWorkflow --task-queue social-tasks \
  -w social-post-1 --input '"catstagram"' --id-conflict-policy TerminateExisting
temporal workflow result -w social-post-1
