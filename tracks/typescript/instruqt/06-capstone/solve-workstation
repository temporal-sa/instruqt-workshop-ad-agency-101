#!/bin/bash
set -euxo pipefail
cd /root/workshop

if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
  nohup .adnet-venv/bin/python services/adnet.py >/tmp/adnet.log 2>&1 &
  sleep 2
fi
if ! temporal operator cluster health >/dev/null 2>&1; then
  nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
    --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
  for i in $(seq 1 30); do
    temporal operator cluster health >/dev/null 2>&1 && break
    sleep 1
  done
fi

pkill -f "06-capstone.*worker.ts" || true
cp -f exercises/06-capstone/solution/*.ts exercises/06-capstone/practice/
nohup npx tsx exercises/06-capstone/practice/worker.ts >/tmp/worker-05.log 2>&1 &
sleep 3

curl -sf -X POST localhost:9999/chaos/on
temporal workflow start --type campaignWorkflow --task-queue campaign-tasks \
  -w campaign-summer-splash --input '"summer-splash"' --id-conflict-policy TerminateExisting
sleep 8
curl -sf -X POST localhost:9999/chaos/off
temporal workflow result -w campaign-summer-splash
