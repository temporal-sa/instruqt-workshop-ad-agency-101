#!/bin/bash
set -euxo pipefail
cd /root/workshop

if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
  nohup .adnet-venv/bin/python services/adnet.py >/tmp/adnet.log 2>&1 &
  sleep 2
fi

if ! temporal operator cluster health >/dev/null 2>&1; then
  nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
    --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
  for i in $(seq 1 30); do
    temporal operator cluster health >/dev/null 2>&1 && break
    sleep 1
  done
fi

# Run the fragile app so the learner's terminal history tells the story
# (expected to crash while chaos is on).
npx tsx exercises/01-meet-the-app/practice/app.ts || true
