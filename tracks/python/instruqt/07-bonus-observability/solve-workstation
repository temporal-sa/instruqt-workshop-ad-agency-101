#!/bin/bash
set -euxo pipefail
cd /root/workshop

# The export needs a completed capstone run. If there isn't one, produce one
# (same flow as challenge 5's solve; lifecycle scripts must be self-contained).
STATUS=$(temporal workflow describe -w campaign-summer-splash -o json 2>/dev/null | jq -r '.workflowExecutionInfo.status' || echo "NOT_FOUND")
if ! echo "$STATUS" | grep -q "COMPLETED"; then
  if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
    nohup uv run services/adnet.py >/tmp/adnet.log 2>&1 &
    sleep 2
  fi
  if ! temporal operator cluster health >/dev/null 2>&1; then
    nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
      --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
    for i in $(seq 1 30); do
      temporal operator cluster health >/dev/null 2>&1 && break
      sleep 1
    done
  fi
  pkill -f "06-capstone.*worker.py" || true
  cp -f exercises/06-capstone/solution/*.py exercises/06-capstone/practice/
  nohup uv run exercises/06-capstone/practice/worker.py >/tmp/worker-05.log 2>&1 &
  sleep 3
  curl -sf -X POST localhost:9999/chaos/on
  temporal workflow start --type CampaignWorkflow --task-queue campaign-tasks \
    -w campaign-summer-splash --input '"summer-splash"' --id-conflict-policy TerminateExisting
  sleep 8
  curl -sf -X POST localhost:9999/chaos/off
  temporal workflow result -w campaign-summer-splash
fi

temporal workflow show -w campaign-summer-splash -o json \
  > exercises/07-bonus-observability/history.json
uv run exercises/07-bonus-observability/replay.py
