#!/bin/bash
# Shared helpers for the Instruqt solve scripts. Source, don't execute.

# Lifecycle scripts may not inherit the image's ENV; pin the Ruby image's gem
# locations so `bundle exec` finds the gems installed at build time.
export GEM_HOME="${GEM_HOME:-/usr/local/bundle}"
export BUNDLE_APP_CONFIG="${BUNDLE_APP_CONFIG:-/usr/local/bundle}"
export PATH="/usr/local/bundle/bin:/usr/local/bin:$PATH"

ensure_services() {
  cd /root/workshop
  if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
    nohup .adnet-venv/bin/python services/adnet.py >/tmp/adnet.log 2>&1 &
    sleep 2
  fi
  if ! temporal operator cluster health >/dev/null 2>&1; then
    nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
      --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
    for _ in $(seq 1 30); do
      temporal operator cluster health >/dev/null 2>&1 && break
      sleep 1
    done
  fi
}

copy_solution() {
  local exercise="$1"
  cp -f "exercises/$exercise/solution/"*.rb "exercises/$exercise/practice/"
}

start_worker() {
  local exercise="$1"
  pkill -f "exercises/$exercise/practice/worker.rb" || true
  nohup bundle exec ruby "exercises/$exercise/practice/worker.rb" \
    >"/tmp/ruby-worker-$exercise.log" 2>&1 &
  sleep 4
}
