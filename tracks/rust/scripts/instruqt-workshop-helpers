#!/bin/bash
# Shared helpers for the Instruqt solve-workstation scripts.

ensure_services() {
  cd /root/workshop
  if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
    nohup .adnet-venv/bin/python services/adnet.py >/tmp/adnet.log 2>&1 &
    sleep 2
  fi
  if ! temporal operator cluster health >/dev/null 2>&1; then
    nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
      --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
    for _ in $(seq 1 30); do
      temporal operator cluster health >/dev/null 2>&1 && break
      sleep 1
    done
  fi
}

copy_solution() {
  local exercise="$1"
  cp -f "exercises/$exercise/solution/"*.rs "exercises/$exercise/practice/"
}

# Stop any running copy of a Worker binary, then start it in the background
# and wait until it reports that it is polling. `cargo run` execs the binary,
# so the running process is target/debug/<bin>.
start_worker() {
  local bin="$1"
  local log="/tmp/rust-worker-$bin.log"
  pkill -f "target/debug/$bin( |$)" || true
  nohup cargo run -q --bin "$bin" >"$log" 2>&1 &
  for _ in $(seq 1 180); do
    grep -q "Worker started" "$log" 2>/dev/null && return 0
    sleep 1
  done
  echo "Worker $bin did not start; see $log" >&2
  return 1
}
