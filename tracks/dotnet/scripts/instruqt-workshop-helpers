#!/bin/bash
# Shared helpers for the .NET track's Instruqt solve scripts.

export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

ensure_services() {
  cd /root/workshop
  if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
    nohup .adnet-venv/bin/python services/adnet.py >/tmp/adnet.log 2>&1 &
    sleep 2
  fi
  if ! temporal operator cluster health >/dev/null 2>&1; then
    nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
      --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
    for _ in $(seq 1 30); do
      temporal operator cluster health >/dev/null 2>&1 && break
      sleep 1
    done
  fi
}

copy_solution() {
  local exercise="$1"
  cp -f "exercises/$exercise/solution/"*.cs "exercises/$exercise/practice/"
}

# start_worker <exercise> <ProjectName>: (re)start the practice Worker project
# in the background and wait until it reports that it is polling.
start_worker() {
  local exercise="$1"
  local project="$2"
  local log="/tmp/dotnet-worker-$exercise.log"
  pkill -f "$project" || true
  sleep 1
  nohup dotnet run --project "exercises/$exercise/practice/$project.csproj" \
    >"$log" 2>&1 &
  for _ in $(seq 1 120); do
    grep -q "Worker started" "$log" 2>/dev/null && return 0
    sleep 1
  done
  echo "Worker $project did not start; see $log" >&2
  return 1
}
