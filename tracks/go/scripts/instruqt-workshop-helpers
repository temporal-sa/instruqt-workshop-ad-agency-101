#!/bin/bash

ensure_services() {
  cd /root/workshop
  if ! curl -sf localhost:9999/health >/dev/null 2>&1; then
    nohup .adnet-venv/bin/python services/adnet.py >/tmp/adnet.log 2>&1 &
    sleep 2
  fi
  if ! temporal operator cluster health >/dev/null 2>&1; then
    nohup temporal server start-dev --ip 0.0.0.0 --ui-ip 0.0.0.0 \
      --db-filename /root/workshop/temporal.db >/tmp/temporal.log 2>&1 &
    for _ in $(seq 1 30); do
      temporal operator cluster health >/dev/null 2>&1 && break
      sleep 1
    done
  fi
}

# Copy the answer key over the practice package. Solution files import their
# sibling solution package, so rewrite those imports to point at practice.
copy_solution() {
  local exercise="$1"
  local src="exercises/$exercise/solution"
  local dst="exercises/$exercise/practice"
  (cd "$src" && find . -name '*.go' -type f) | while IFS= read -r file; do
    mkdir -p "$dst/$(dirname "$file")"
    sed "s#workshop/exercises/$exercise/solution#workshop/exercises/$exercise/practice#" \
      "$src/$file" >"$dst/$file"
  done
}

# Stop every running workshop Worker: learner-started `go run` processes
# (and the binaries they spawn) plus Workers started by these scripts.
stop_workers() {
  pkill -f "go run ./exercises/.*/worker" || true
  pkill -f "/exe/worker( |$)" || true
  pkill -f "/tmp/go-worker-" || true
  sleep 1
}

start_worker() {
  local exercise="$1"
  stop_workers
  go build -o "/tmp/go-worker-$exercise" "./exercises/$exercise/practice/worker"
  nohup "/tmp/go-worker-$exercise" >"/tmp/go-worker-$exercise.log" 2>&1 &
  sleep 3
}
